<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.penny.export</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/macmini/penny/venv/bin/python3</string>
        <string>/Users/macmini/penny/scripts/backup_penny.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- IMPORTANT: launchd doesn't inherit shell PATH -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <!-- This tracked file is a template; deployment injects the exact checkout SHA. -->
        <key>PENNY_SOURCE_REVISION</key>
        <string>YOUR_PENNY_SOURCE_REVISION_HERE</string>
        <key>PENNY_TRANSCRIPT_DB</key>
        <string>/Users/macmini/.penny/transcripts.db</string>
        <key>PENNY_ARCHIVE_OBJECT_ROOT</key>
        <string>/Users/macmini/.penny/archive/objects</string>
        <key>PENNY_BACKUP_ROOT</key>
        <string>/Users/macmini/.penny/backup</string>
        <key>PENNY_BACKUP_REMOTE</key>
        <string>homelab:~/backups/penny</string>
        <key>PENNY_BACKUP_VERIFICATION_RECEIPT</key>
        <string>/Users/macmini/.penny/backup/last_verification.json</string>
        <key>PENNY_BACKUP_SCRATCH_ROOT</key>
        <string>/Users/macmini/.penny/backup-scratch</string>
    </dict>
    <key>StartInterval</key>
    <integer>21600</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/macmini/.penny/logs/export.system.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/macmini/.penny/logs/export.system.log</string>
    <key>WorkingDirectory</key>
    <string>/Users/macmini/penny</string>
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>1024</integer>
    </dict>
</dict>
</plist>
