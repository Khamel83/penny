<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.penny.tasks</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/macmini/penny/venv/bin/python3</string>
        <string>/Users/macmini/penny/tasks_poller.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- IMPORTANT: launchd doesn't inherit shell PATH -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <!-- This tracked file is a template; deployment injects the exact checkout SHA. -->
        <key>PENNY_SOURCE_REVISION</key>
        <string>YOUR_PENNY_SOURCE_REVISION_HERE</string>
        <key>PENNY_TRANSCRIPT_DB</key>
        <string>/Users/macmini/.penny/transcripts.db</string>
        <!-- Transitional direct classification only; Maya remains the target boundary. -->
        <key>OPENROUTER_API_KEY</key>
        <string>YOUR_OPENROUTER_API_KEY_HERE</string>
        <key>GOOGLE_CREDENTIALS_FILE</key>
        <string>/Users/macmini/.penny/google_credentials.json</string>
        <key>GOOGLE_TOKEN_FILE</key>
        <string>/Users/macmini/.penny/google_token.json</string>
        <key>MAYA_TRANSCRIPT_URL</key>
        <string>YOUR_MAYA_TRANSCRIPT_URL_HERE</string>
        <key>MAYA_INGEST_TOKEN</key>
        <string>YOUR_MAYA_INGEST_TOKEN_HERE</string>
        <key>PENNY_HERMES_WEBHOOK_SECRET</key>
        <string>YOUR_PENNY_HERMES_WEBHOOK_SECRET_HERE</string>
        <key>HERMES_WEBHOOK_URL</key>
        <string>YOUR_HERMES_WEBHOOK_URL_HERE</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/macmini/.penny/logs/tasks.system.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/macmini/.penny/logs/tasks.system.log</string>
    <key>WorkingDirectory</key>
    <string>/Users/macmini/penny</string>
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>1024</integer>
    </dict>
</dict>
</plist>
