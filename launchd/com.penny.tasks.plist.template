<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.penny.tasks</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/macmini/penny/venv/bin/python3</string>
        <string>/Users/macmini/penny/tasks_poller.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- IMPORTANT: launchd doesn't inherit shell PATH -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <!-- Replace with actual values -->
        <key>OPENROUTER_API_KEY</key>
        <string>YOUR_OPENROUTER_API_KEY_HERE</string>
        <key>TELEGRAM_BOT_TOKEN</key>
        <string>YOUR_BOT_TOKEN_HERE</string>
        <key>TELEGRAM_CHAT_ID</key>
        <string>YOUR_CHAT_ID_HERE</string>
        <key>GOOGLE_CREDENTIALS_FILE</key>
        <string>/Users/macmini/.penny/google_credentials.json</string>
        <key>GOOGLE_TOKEN_FILE</key>
        <string>/Users/macmini/.penny/google_token.json</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/macmini/.penny/logs/tasks.system.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/macmini/.penny/logs/tasks.system.log</string>
    <key>WorkingDirectory</key>
    <string>/Users/macmini/penny</string>
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>1024</integer>
    </dict>
</dict>
</plist>
