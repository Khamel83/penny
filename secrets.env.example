# Copy this file to secrets.env and fill in real values.
# secrets.env is gitignored — never commit it.
# These values go in the launchd plist EnvironmentVariables on the Mac Mini.

OPENROUTER_API_KEY=sk-or-v1-...

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Slack bot token and the channel ID for #penny.
SLACK_BOT_TOKEN=xoxb-...
PENNY_SLACK_CHANNEL=C0123456789

# Paths to Google OAuth files on the Mac Mini (created during google_auth.py setup)
GOOGLE_CREDENTIALS_FILE=/Users/macmini/.penny/google_credentials.json
GOOGLE_TOKEN_FILE=/Users/macmini/.penny/google_token.json
