# Copy this file to secrets.env and fill in real values.
# secrets.env is gitignored — never commit it.
# These values go in the launchd plist EnvironmentVariables on the Mac Mini.

OPENROUTER_API_KEY=sk-or-v1-...

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Paths to Google OAuth files on the Mac Mini (created during google_auth.py setup)
GOOGLE_CREDENTIALS_FILE=/Users/macmini/.penny/google_credentials.json
GOOGLE_TOKEN_FILE=/Users/macmini/.penny/google_token.json

# Slack transcript mirroring for Penny voice memos
PENNY_SLACK_BOT_TOKEN=xoxb-your-token
PENNY_SLACK_CHANNEL_ID=C0BKS0QT7FU
PENNY_MAYA_LEDGER_CHANNEL_ID=your-maya-ledger-channel-id

# iOS Shortcut alternate-ingress bearer token; do not reuse PENNY_WEBHOOK_SECRET.
PENNY_INGEST_TOKEN=your-dedicated-ingest-token
# Explicitly opt into a LAN listener when required; config.toml defaults to 127.0.0.1.
PENNY_WEBHOOK_HOST=0.0.0.0

# Penny -> Maya v2 delivery
MAYA_TRANSCRIPT_URL=https://your-maya-host/ingest/transcript
MAYA_INGEST_TOKEN=your-dedicated-ingest-token
MAYA_DELIVERY_TIMEOUT_SECONDS=10
