# Penny runtime environment example
#
# Copy this file to a mode-0600, gitignored runtime secret file. These values
# are inputs for the installed launchd jobs; this tracked file is a template,
# not evidence that any installed plist is loaded or approved. Never print or
# commit the filled-in file.

# Transitional direct classification only. This is not the transcription path
# and remains until the authenticated Maya replacement is deployed and proven.
OPENROUTER_API_KEY=sk-or-v1-...

# Dedicated boundary credentials; never reuse one value for another boundary.
PENNY_INGEST_TOKEN=YOUR_PENNY_INGEST_TOKEN_HERE
PENNY_WEBHOOK_SECRET=YOUR_PENNY_WEBHOOK_SECRET_HERE
# Dedicated Hermes HMAC credential; never reuse the webhook callback secret.
PENNY_HERMES_WEBHOOK_SECRET=YOUR_PENNY_HERMES_WEBHOOK_SECRET_HERE
HERMES_WEBHOOK_URL=YOUR_HERMES_WEBHOOK_URL_HERE
PENNY_SLACK_BOT_TOKEN=xoxb-your-token
PENNY_SLACK_CHANNEL_ID=C0BKS0QT7FU
PENNY_MAYA_LEDGER_CHANNEL_ID=YOUR_PENNY_MAYA_LEDGER_CHANNEL_ID_HERE
MAYA_INGEST_TOKEN=YOUR_MAYA_INGEST_TOKEN_HERE
MAYA_TRANSCRIPT_URL=YOUR_MAYA_TRANSCRIPT_URL_HERE
MAYA_DELIVERY_TIMEOUT_SECONDS=10

# Source/runtime identity. PENNY_SOURCE_REVISION is injected by the deployed
# process and must be the exact 40-hex checkout revision.
PENNY_SOURCE_REVISION=YOUR_PENNY_SOURCE_REVISION_HERE

# Transcription is local-only at runtime. Network access is permitted only by
# the explicit model-provisioning command, never by watcher/webhook startup.
HF_HUB_OFFLINE=1
PENNY_WHISPER_MODEL_PATH=/Users/macmini/.penny/models/whisper-large-v3-turbo/a4aaeec0636e6fef84abdcbe3544cb2bf7e9f6fb

# Loopback is the default. A non-loopback bind requires a separately protected
# deployment and an explicit opt-in; do not change this casually.
PENNY_WEBHOOK_HOST=127.0.0.1
PENNY_WEBHOOK_ALLOW_NONLOOPBACK=0

# Canonical SQLite and durable archive settings. The local object root must be
# outside iCloud/File Provider storage; Penny Archive is a rebuildable mirror.
PENNY_TRANSCRIPT_DB=~/.penny/transcripts.db
PENNY_ARCHIVE_OBJECT_ROOT=~/.penny/archive/objects
PENNY_ARCHIVE_MIRROR_ROOT=~/Library/Mobile Documents/com~apple~CloudDocs/Penny Archive
PENNY_ARCHIVE_DELIVERY_BATCH_LIMIT=5

# Independent versioned backup settings. Verification is scratch-only and the
# metadata-only receipt advances only after local and remote verification pass.
PENNY_BACKUP_ROOT=~/.penny/backup
PENNY_BACKUP_REMOTE=homelab:~/backups/penny
PENNY_BACKUP_VERIFICATION_RECEIPT=~/.penny/backup/last_verification.json
PENNY_BACKUP_SCRATCH_ROOT=~/.penny/backup-scratch

# Health freshness files are metadata-only supporting signals for Doctor.
PENNY_HEALTH_FILE=~/.penny/health.txt
PENNY_TASKS_HEALTH_FILE=~/.penny/health_tasks.txt

# Apple/Google and Slack integrations keep their own runtime state. These
# paths are not secrets themselves, but their contents must remain private.
GOOGLE_CREDENTIALS_FILE=~/.penny/google_credentials.json
GOOGLE_TOKEN_FILE=~/.penny/google_token.json
